{
  "appliance_id": "b3e94412-d852-4e08-9df5-60b6c6b3bb99",
  "name": "BIND DNS Server",
  "category": "guest",
  "description": "BIND 9 authoritative and recursive DNS server for GNS3 network topologies, demonstrations, and teaching labs. Originally developed by Karim Kanso, maintained and enhanced by Stephan Kleber. Features zero-config demonstration mode out of the box, real-time query logging, and simple configuration via environment variables.",
  "vendor_name": "Internet Systems Consortium",
  "vendor_url": "https://www.isc.org/bind/",
  "product_name": "BIND 9 DNS Appliance",
  "product_url": "https://github.com/skleber/gns3-bind",
  "registry_version": 4,
  "status": "stable",
  "maintainer": "Stephan Kleber",
  "maintainer_email": "stephan.kleber@rwu.de",
  "usage": "Configure the DNS server via environment variables in the node properties (Right-click node -> Configure -> Environment):\n\n- Variables are set one per line as KEY=value (no 'export', no outer quotes).\n- Define zones with DOMAIN_<zone>=<records> (replace dots '.' with '_').\n  Record format: owner,type,rdata (space-separated).\n  Example: DOMAIN_site=alice,A,192.168.111.17 bob,A,192.168.111.18\n  Example: DOMAIN_example_com=@,A,10.0.0.1 www,A,10.0.0.10 @,MX,10,mail.example.com.\n- Server role: AUTHORITATIVE=self (default standalone root) or AUTHORITATIVE=iana,<forwarder_ip> (forwarding resolver).\n- Live query logging: QUERY_LOG=yes\n- Restart the node after changing environment variables.\n\nSee Usage.md for details.",
  "symbol": ":/symbols/classic/server.svg",
  "docker": {
    "adapters": 1,
    "image": "ghcr.io/skleber/gns3-bind:latest",
    "console_type": "telnet",
    "environment": "QUERY_LOG=yes\nAUTHORITATIVE=self\nDOMAIN_site=alice,A,192.168.111.17"
  }
}
