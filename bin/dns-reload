# Validate configuration and reload BIND without restarting the container
echo "[*] Validating BIND configuration..."
if named-checkconf -z /etc/bind/named.conf; then
    echo "[+] Configuration valid! Reloading BIND daemon..."
    if rndc reload; then
        echo "[+] BIND reloaded successfully."
    else
        echo "[!] Failed to reload BIND via rndc."
        exit 1
    fi
else
    echo "[!] Configuration check failed. Not reloading."
    exit 1
fi
